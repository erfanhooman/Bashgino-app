# Line endings and diff behaviour (one repository, one convention).
* text=auto eol=lf

*.png      binary
*.jpg      binary
*.jpeg     binary
*.webp     binary
*.gif      binary
*.ico      binary
*.ttf      binary
*.otf      binary
*.woff     binary
*.woff2    binary
*.jks      binary
*.keystore binary

