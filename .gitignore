# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# IDE / editor metadata (never useful to anyone else)
.idea/
.vscode/
*.iml

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files — the API origin is the only build-time value and it is public,
# but real environment files never belong in git
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

# generated native folders (recreated by `expo prebuild` in CI)
/ios
/android

# release artefacts
*.apk
*.aab
build/
