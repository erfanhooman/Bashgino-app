# Base URL of the Bashgino API, as the phone reaches it.
#
# This is a BUILD-TIME value: `EXPO_PUBLIC_*` is inlined into the JavaScript
# bundle, so it is public by definition. Never put a secret here.
#
#   development   http://10.0.2.2:8888   (Android emulator alias for the host)
#   release       https://api.bashgino.ir
#
# The release workflow sets this from the repository variable
# EXPO_PUBLIC_API_URL and also stamps it into app.json (`extra.apiUrl`), so a
# tagged build never falls back to the emulator alias.
EXPO_PUBLIC_API_URL=https://api.bashgino.ir
